# Environment variables example
# Copy this file to .env.local and update the values as needed.
#
# Finalcliper is offline-first: no database, auth, CMS, analytics, or
# third-party API keys are required to build or run it. This is
# intentionally short.

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Studio (OPTIONAL, gated online feature — see docs/DECISIONS.md)
# Leave BOTH unset for a fully-offline build. Set them to enable the
# right-hand AI Studio panel that generates viral videos from a niche via
# Google's Generative Language API (Veo + Gemini).
#
#   GEMINI_API_KEY is SERVER-ONLY: it is read exclusively in server route
#   handlers and never shipped to the browser. Do NOT prefix it with
#   NEXT_PUBLIC_. Keep it in .env.local (gitignored), never commit it.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_AI_ENABLED=true
# GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Social Media Video Uploader (OPTIONAL)
# You can configure server-wide keys for YouTube and TikTok here, or let
# users configure tokens directly in the app. Instagram uses the unified
# OAuth connection configured below.
# ---------------------------------------------------------------------------
# YOUTUBE_ACCESS_TOKEN=your-google-oauth-access-token
# TIKTOK_ACCESS_TOKEN=your-tiktok-content-posting-token

# ---------------------------------------------------------------------------
# YouTube Unified Connection (Analytics + Publishing) (OPTIONAL)
# Gated online feature — see docs/YOUTUBE-ANALYTICS.md.
# Connect your YouTube channel via Google OAuth to enable both YouTube Studio
# analytics (views, watch time, retention, AI reports) and direct video publishing.
#
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are SERVER-ONLY. Create an OAuth 2.0
#   Client ID (Web application) in Google Cloud Console. The redirect URI is:
#   http://localhost:3000/api/youtube/oauth/callback
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_YOUTUBE_ANALYTICS_ENABLED=true
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# ---------------------------------------------------------------------------
# Instagram Unified Connection (Analytics + Publishing) (OPTIONAL)
# Gated online feature — see docs/DECISIONS.md and docs/IG-ANALYTICS.md.
# Connect your Instagram Professional account once via OAuth to enable
# both Reels analytics and direct Reel publishing.
#
#   IG_APP_ID / IG_APP_SECRET are SERVER-ONLY (never NEXT_PUBLIC_). Create a
#   Meta app with the "Instagram" product and use its credentials. The OAuth
#   redirect URI to register in the Meta app is:
#   http://localhost:3000/api/instagram/oauth/callback
#   (or your tunnel URI /api/instagram/oauth/callback)
#
#   LLM_* point at any OpenAI-compatible chat-completions endpoint for
#   AI-written reports (e.g. Z.ai GLM, OpenAI). Without them, reports fall
#   back to GEMINI_API_KEY, then to a rule-based generator.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_IG_ANALYTICS_ENABLED=true
# IG_APP_ID=your-app-id
# IG_APP_SECRET=your-app-secret
# IG_REDIRECT_URI=https://your-domain.ngrok-free.dev/api/instagram/oauth/callback
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=your-llm-api-key
# LLM_MODEL=your-model-name

# ---------------------------------------------------------------------------
# Clerk Authentication (OPTIONAL)
# Sign up at https://clerk.com to get your keys.
# When provided, user projects and storage are scoped per user account.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

